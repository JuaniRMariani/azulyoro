# Copy to .env.local (git-ignored) and fill in real values.

# Base URL of the .NET API (Azulyoro.Api / Kestrel).
# Dev: http://localhost:5000  ·  Prod: https://api.azulyoro.com.ar
NEXT_PUBLIC_API_URL=http://localhost:5000

# Shared secret guarding POST /api/revalidate (must match the backend's
# Frontend:RevalidateSecret). Generate with: openssl rand -hex 24
REVALIDATE_SECRET=replace_with_shared_revalidate_secret
