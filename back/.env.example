# ============================================================================
#  Azulyoro API — configuration reference
# ============================================================================
# DEV: set each key via user-secrets (colon separator), e.g.:
#   dotnet user-secrets set "ApiFootball:Key" "xxxx" -p src/Azulyoro.Api
# PROD: put them in the systemd EnvironmentFile (/etc/azulyoro/api.env) using
#   the double-underscore convention shown below (Section__Key).
# Only ConnectionStrings__Postgres is strictly required to boot; the rest
# enable the respective feature (empty Brevo key → emails are just logged).
# ----------------------------------------------------------------------------

# --- Database (REQUIRED) --------------------------------------------------
# Local dev Postgres. Prod: point to the VPS Postgres + the azulyoro DB user.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=azulyoro;Username=azulyoro;Password=CHANGE_ME

# --- API-Football (sports data) -------------------------------------------
# Get it at https://dashboard.api-football.com  (o https://www.api-sports.io)
# → your account → API key. Free tier for dev, Pro (~USD 19/mo) for prod.
ApiFootball__Key=replace_with_api_football_key
# Optional (has a sensible default):
# ApiFootball__BaseUrl=https://v3.football.api-sports.io

# --- Brevo (transactional email) ------------------------------------------
# Get the key at https://app.brevo.com → SMTP & API → API Keys (v3).
# Leave ApiKey empty in dev to use the console LoggingEmailSender.
# FromEmail must be a sender/domain verified in Brevo.
Brevo__ApiKey=replace_with_brevo_key
Brevo__FromEmail=no-reply@azulyoro.com.ar
Brevo__FromName=Azul y Oro

# --- Frontend integration -------------------------------------------------
# Base URL of the Next front. Used for on-publish revalidation calls and for
# the links inside verification / newsletter emails.
# Dev: http://localhost:3000  ·  Prod: https://azulyoro.com.ar
Frontend__BaseUrl=http://localhost:3000
# Shared secret guarding POST {front}/api/revalidate. MUST equal the front's
# REVALIDATE_SECRET. Generate with:  openssl rand -hex 24
Frontend__RevalidateSecret=replace_with_shared_revalidate_secret

# --- Auth cookie ----------------------------------------------------------
# Leave empty in dev (localhost). Prod: .azulyoro.com.ar so the session cookie
# is shared between the site and the API subdomain.
Auth__CookieDomain=

# --- CORS allow-list ------------------------------------------------------
# Origins allowed to call the API with credentials. Defaults to
# https://azulyoro.com.ar + http://localhost:3000 when unset.
# Cors__Origins__0=https://azulyoro.com.ar
# Cors__Origins__1=http://localhost:3000
