# Backend configuration keys.
#
# DEV: set these via `dotnet user-secrets` (never commit real values):
#   dotnet user-secrets set "ConnectionStrings:Postgres" "..." -p src/Azulyoro.Api
#   dotnet user-secrets set "ApiFootball:Key" "..."          -p src/Azulyoro.Api
#   dotnet user-secrets set "Brevo:ApiKey" "..."             -p src/Azulyoro.Api
#   dotnet user-secrets set "Frontend:RevalidateSecret" "..." -p src/Azulyoro.Api
#
# PROD: provide the same keys via the systemd EnvironmentFile using the
# ASP.NET Core double-underscore convention (Section__Key), e.g.:

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=azulyoro;Username=azulyoro;Password=CHANGE_ME
ApiFootball__Key=replace_with_api_football_key
Brevo__ApiKey=replace_with_brevo_key
Frontend__RevalidateSecret=replace_with_shared_revalidate_secret
