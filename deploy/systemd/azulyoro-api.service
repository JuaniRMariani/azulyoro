[Unit]
Description=Azulyoro API (.NET Kestrel)
After=network.target postgresql.service

[Service]
Type=notify
WorkingDirectory=/var/www/azulyoro/api
ExecStart=/usr/bin/dotnet /var/www/azulyoro/api/Azulyoro.Api.dll
Restart=always
RestartSec=5
User=azulyoro
Group=azulyoro
# Kestrel binds loopback only; Nginx proxies to it.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
# Secrets (ConnectionStrings__Postgres, ApiFootball__Key, Brevo__ApiKey,
# Frontend__RevalidateSecret) live here, root-only readable.
EnvironmentFile=/etc/azulyoro/api.env

[Install]
WantedBy=multi-user.target
