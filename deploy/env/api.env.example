# Production EnvironmentFile for azulyoro-api.service.
# Keep the real file at /etc/azulyoro/api.env with mode 600.
# Values are intentionally blank here; do not commit credentials.

ConnectionStrings__Postgres=
AllowedHosts=azulyoro.com.ar;api.azulyoro.com.ar;127.0.0.1;localhost

ApiFootball__Key=
ApiFootball__BaseUrl=
ApiFootball__MaxRetryAttempts=
ApiFootball__RetryBaseDelayMs=
ApiFootball__RequestTimeoutSeconds=

Brevo__ApiKey=
Brevo__FromEmail=
Brevo__FromName=

Frontend__BaseUrl=
Frontend__RevalidateSecret=

Auth__CookieDomain=
Cors__Origins__0=

DataProtection__KeysPath=/var/lib/azulyoro/keys
DataProtection__CertificatePath=/etc/azulyoro/dataprotection.crt
DataProtection__CertificateKeyPath=/etc/azulyoro/dataprotection.key
