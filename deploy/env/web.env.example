# Production EnvironmentFile for azulyoro-web.service.
# Keep the real file at /etc/azulyoro/web.env with mode 600.
# NEXT_PUBLIC_* values are embedded during `pnpm build` and also used at runtime.

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
REVALIDATE_SECRET=
API_INTERNAL_URL=http://127.0.0.1:5000
